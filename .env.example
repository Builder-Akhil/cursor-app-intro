# Dedicated Fable Supabase project (not the invoice hangar).
# Copy to .env.local — never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Used for email-confirm redirects in production (optional locally).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Stories use gpt-5.6-luna. Vision boards use gpt-image-2.5-flare.
OPENAI_API_KEY=

# Server-only. n8n webhook that receives POST JSON { name, email }.
# Test URL (/webhook-test/...) is fine while you build — click Execute workflow first.
# Production URL (/webhook/...) when you want it always on.
N8N_WEBHOOK_URL=
